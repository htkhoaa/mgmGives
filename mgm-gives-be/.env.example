# Copy this file to .env and fill in the actual values.
# When running with Docker, use 'db' as the host (the service name in docker-compose).
# When running locally (without Docker), use 'localhost' as the host.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/mgmgives
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here
SERVER_PORT=8080
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

FROM_MAIL=
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_VERIFY_EXPIRATION=864000000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Default admin user seeded on first startup (required)

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_FULL_NAME=Admin

GEMINI_API_KEY=your_actual_key_here
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REFRESH_TOKEN=
WEBEX_API_BASE_URL=
WEBEX_REDIRECT_URI=

# Payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=